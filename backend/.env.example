# Copy this file to backend/.env and fill in real values. Never commit .env.

# --- Gemini (AI assistant / report summaries) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, a random key is generated at process start (dev only -- invalidates
# sessions on every restart and MUST be set explicitly for any shared/deployed env).
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Database ---
# Defaults to a local SQLite file at backend/neuroshield.db if unset.
DATABASE_URL=

# --- CORS ---
# Comma-separated exact origins allowed to call this API. Never "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- File uploads ---
UPLOAD_DIR=

# --- Demo accounts (local development only) ---
# When true, seeds one demo user per role (patient/caregiver/neurologist/admin)
# on first startup if the users table is empty. Disable for any shared deployment.
SEED_DEMO_USERS=true
DEMO_PASSWORD=NeuroDemo#2026

# --- n8n orchestration (wired in a later pass) ---
N8N_WEBHOOK_BASE=
